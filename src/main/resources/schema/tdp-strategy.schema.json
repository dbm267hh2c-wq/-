{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdp.example.cn/schema/tdp-strategy.schema.json",
  "title": "国内合约策略",
  "type": "object",
  "additionalProperties": true,
  "required": ["subjectInfo", "actions"],
  "properties": {
    "subjectInfo": {
      "type": "object",
      "required": ["dataProductId"],
      "properties": {
        "dataProductId": { "type": "string", "minLength": 1 },
        "dataProductName": { "type": "string" }
      }
    },
    "executionNodeInfo": { "type": "object" },
    "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["constraintName", "constraintOperator", "constraintValue"],
        "properties": {
          "constraintName": { "type": "string" },
          "constraintOperator": { "type": "string" },
          "constraintValue": { "type": "string" }
        }
      }
    },
    "policyExpansion": { "type": "string" }
  }
}
